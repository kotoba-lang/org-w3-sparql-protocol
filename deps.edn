{:paths ["src"]
 ;; kotoba-lang/sparql provides the SPARQL algebra (sparql.core) this repo
 ;; wraps the HTTP protocol around, unmodified -- see src/kotobase/
 ;; protocols/sparql.cljc's ns docstring. kotoba-lang/kotobase-query
 ;; provides the bridge (kotobase.query.bridge) that materializes
 ;; kotobase.store/IStore collections into the arrangement.core db this
 ;; repo's own kotobase.protocols.sparql.quads walks to build RDF quads.
 ;; ADR-2607172300's dependency table for org-w3-sparql-protocol lists
 ;; exactly these two -- kotobase-protocols (the sibling wire-protocol
 ;; STYLE reference) is deliberately NOT a dependency, see
 ;; kotobase.protocols.sparql.json's ns docstring.
 ;;
 ;; kotobase-query's own deps.edn pulls in kotobase + arrangement, and
 ;; arrangement's own deps.edn pulls in prolly-tree/io-ipld (its
 ;; commit!/CID-snapshot machinery, unused by this repo but required at
 ;; namespace-load time) which in turn pull in io-multiformats/org-ietf-cbor
 ;; -- tools.deps resolves that whole chain transitively from the two
 ;; direct deps below for the JVM :test alias. The nbb primary test path
 ;; has no dependency resolver, so bin/run_tests.cljs / CI clone each
 ;; transitive dep by hand into its own .deps/<name> -- see the README's
 ;; Develop/test section for the exact command.
 ;; datom-source is the IPatternSource contract this repo's `source->quads`
 ;; scans (the pushdown path, ADR-2608039970). Zero deps of its own.
 :deps {io.github.kotoba-lang/datom-source
        {:git/sha "b42f6e6ff942c7f8a2856f8142ebffc13aa11098"}
        io.github.kotoba-lang/sparql
        {:git/sha "1029b50cbbbdbc4f76a7c2e7bf86728068ef368b"}
        io.github.kotoba-lang/kotobase-query
        {:git/sha "b8bb880d56d242f9a98bd4a9c0375abb4b633bdb"}}
 ;; First-class runtime is nbb/cljs (repo-wide runtime priority):
 ;;   nbb --classpath "src:test:.deps/sparql/src:.deps/kotobase-query/src:.deps/kotobase/src:.deps/arrangement/src:.deps/prolly-tree/src:.deps/io-ipld/src:.deps/io-multiformats/src:.deps/org-ietf-cbor/src" bin/run_tests.cljs
 ;; The :test alias below is the :clj COMPAT suite only -- not the
 ;; primary execution path.
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
       ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
       :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
